# Copy to .env and fill in real values. Never commit .env.

# --- LLM providers ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Amazon live data (pick one provider) ---
RAINFOREST_API_KEY=

# --- eBay Developer REST API (OAuth) ---
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENVIRONMENT=production

# --- Generic scraping proxy fallback (optional) ---
BRIGHTDATA_API_KEY=
SCRAPINGBEE_API_KEY=

# --- Storefront targets ---
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_API_TOKEN=
SHOPIFY_API_VERSION=2024-07

# --- Integration test fixtures (real IDs for live tests) ---
TEST_AMAZON_ASIN=
TEST_EBAY_ITEM_ID=

# --- Runtime ---
LOG_LEVEL=INFO
LOG_DIR=logs
